      "close_digest": {
        "high_value_only": true,
        "max_items": 2,
        "preferred_alert_type_bundle": "opening_theme_confirmation"
      },
      "intent_label": "opening-risk-and-theme-check",
      "focus_tags": [
        "open-confirmation",
        "theme-follow-through"
      ],
      "view_template": "opening_task_view",
      "preferred_chain_group_bundle": "opening_confirmation_chains",
      "strategy_note": "Watch whether the opening move is being confirmed by theme leaders instead of reacting to noise from the first few minutes.",
