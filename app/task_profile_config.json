      "close_digest": {
        "high_value_only": false,
        "max_items": 2,
        "preferred_alert_type_bundle": "mid_session_structure_focus"
      },
      "intent_label": "mid-session-expansion-check",
      "focus_tags": [
        "breadth-expansion",
        "mid-session-structure"
      ],
      "preferred_chain_group_bundle": "mid_session_expansion_chains",
      "strategy_note": "Use midday to judge whether the main line is broadening from leaders into the wider chain or staying narrow.",
      "console_title": "盘中检查",
      "console_subtitle": "盘中扩散与广度检查",
      "result_summary_style": "midday_check"
    },
    "afternoon-review": {
      "view_template": "close_review_task_view",
      "intraday_digest": {
        "high_value_only": false,
        "max_items": 3,
        "preferred_alert_type_bundle": "mid_session_structure_focus"
      },
      "close_digest": {
        "high_value_only": false,
        "max_items": 4,
        "preferred_alert_type_bundle": "mid_session_expansion"
      },
      "intent_label": "close-review-and-structure-check",
      "focus_tags": [
        "close-structure",
        "theme-retention"
      ],
      "preferred_chain_group_bundle": "close_retention_chains",
      "strategy_note": "Shift attention to what can still hold into the close so the next-day watchlist is based on retained structure, not intraday spikes.",
      "console_title": "尾盘复盘",
      "console_subtitle": "收盘结构与题材复盘",
      "result_summary_style": "afternoon_review"
    }
