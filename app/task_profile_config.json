      "console_subtitle": "盘前准备与隔夜风险扫描",
      "result_summary_style": "pre_open"
    },
    "morning-check": {
      "intraday_digest": {
        "high_value_only": true,
        "max_items": 2,
        "preferred_alert_type_bundle": "opening_theme_confirmation"
