  "market_focus_state_rules": [
    {
      "state": "divergence risk rising",
      "minimum_red_count": 2,
      "minimum_strongest_avg": 0.0,
      "minimum_secondary_avg": 0.0,
      "minimum_high_value_count": 0,
      "minimum_strongest_gap": 0.0
    },
    {
      "state": "breadth expansion",
      "minimum_red_count": 0,
      "minimum_strongest_avg": 4.0,
      "minimum_secondary_avg": 2.5,
      "minimum_high_value_count": 2,
      "minimum_strongest_gap": 0.0
    },
    {
      "state": "leader continuation",
      "minimum_red_count": 0,
      "minimum_strongest_avg": 4.0,
      "minimum_secondary_avg": 0.0,
      "minimum_high_value_count": 0,
      "minimum_strongest_gap": 2.0
    },
    {
      "state": "mixed rotation",
      "minimum_red_count": 0,
      "minimum_strongest_avg": 2.0,
      "minimum_secondary_avg": 0.0,
      "minimum_high_value_count": 1,
      "minimum_strongest_gap": 0.0
    }
  ],
